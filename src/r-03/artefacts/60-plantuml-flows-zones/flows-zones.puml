@startuml
' Диаграмма потоков движения динамических компонентов между зонами СЦ
' Задача: src\r-03\prompts\60-plantuml-flows-zones.txt
' Основание: спецификация разделы 5-6, артефакты этапов 1, 2, 5

top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam ranksep 60
skinparam nodesep 25
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam rectangle {
  BorderColor #444444
}

' ==== Внешние источники / стоки (серые) ====
rectangle "Входная машина\n(магистральный транспорт)" as in1 #FAFAFA
rectangle "Исходящая машина\n32 паллеты:\n16 паллет с ящиками (320 ящиков) +\n16 паллет с роллтейнерами\n(погрузка 2 ч)" as m2 #FAFAFA
rectangle "Вывоз\n(брак, отходы,\nвозврат паллет)" as out1 #FAFAFA

' ==== Зоны основного потока (оранжевые) ====
rectangle "Приёмочные ворота\n6-8 шт (ориентир)" as g1 #FFA500
rectangle "Буфер приёмки\n~400 паллетомест" as b1 #FFA500
rectangle "Разукрупнение\nдепаллетайзеры 3-4 шт" as z2 #FFA500
rectangle "Вскрытие ящиков\nмашины вскрытия 8-10 шт" as z3 #FFA500
rectangle "Подача (инфиды)\n10 шт инфид-станций +\n10 комплектов сканеров/весов" as z5 #FFA500
rectangle "Сортировка\n10 шт сортировщиков,\n400 направлений" as z6 #FFA500
rectangle "Заполнение ящиков\n(скаты/накопители,\nэтап после сортировки)" as f1 #FFA500
rectangle "Заклейка\nзаклейщики 3-4 шт" as z7 #FFA500
rectangle "Сортировка ящиков\nпо направлениям\n1 шт система, 400 ячеек" as z8 #FFA500
rectangle "Паллетирование\nпаллетайзеры 4-6 шт" as z9 #FFA500
rectangle "Буфер отгрузки\n~370 паллетомест" as b2 #FFA500
rectangle "Ворота отгрузки\n24 шт (ТЗ)" as g2 #FFA500

' ==== Зоны потоков ящиков (розовые) ====
rectangle "Сток пустых ящиков\n(повторные + новые)" as z4 #FFB6C1
rectangle "Машина новых ящиков\n1 шт" as m3 #FFB6C1
rectangle "Брак и отходы\nкомпактор 1 шт" as z13 #FFB6C1

' ==== Зоны потоков паллет (голубые) ====
rectangle "Накопитель\nпустых паллет" as zp #87CEFA

' ==== Зоны потока nonsort (зелёные) ====
rectangle "Nonsort: адресные ячейки\nручная сортировка по направлениям\n(операторы, 250 товаров/ч на чел.\nпо 20 направлениям — ТЗ)" as n1 #90EE90
rectangle "Nonsort: роллтейнер-станции\nукладка отсортированных товаров\n(16 роллтейнеров на машину)" as n2 #90EE90

' ==== Зоны возвратных потоков (фиолетовые) ====
rectangle "Возвратные потоки\nканалы повторного\nпрогона / отбраковки" as z12 #DDA0DD

' ==== Инфраструктура (серая) ====
rectangle "Инфраструктура\nсерверная,\nзарядные станции\nроботов-перевозчиков" as z14 #D3D3D3

' ==== ОСНОВНОЙ ПОТОК ТОВАРОВ (самый яркий - красно-оранжевый, толстый) ====
in1 -[#FF4500,thickness=3]-> g1 : паллеты с ящиками, 185 паллет/ч (ТЗ)
g1 -[#FF4500,thickness=3]-> b1 : входные паллеты (буферизация)
b1 -[#FF4500,thickness=3]-> z2 : паллеты на разукрупнение
z2 -[#FF4500,thickness=3]-> z3 : ящики с товарами (съём с паллет)
z3 -[#FF4500,thickness=3]-> z5 : товары (после выемки из ящиков)
z5 -[#FF4500,thickness=3]-> z6 : товары (сканер, вес, габариты)
z6 -[#FF4500,thickness=3]-> f1 : товары (сброс на скаты по 400 направлениям)
f1 -[#FF4500,thickness=3]-> z7 : заполненные ящики (съём, утряска)
z7 -[#FF4500,thickness=3]-> z8 : заклеенные ящики по направлениям (400)
z8 -[#FF4500,thickness=3]-> z9 : ящики на паллеты (20 шт/паллета)
z9 -[#FF4500,thickness=3]-> b2 : исходящие паллеты
b2 -[#FF4500,thickness=3]-> g2 : паллеты к воротам
g2 -[#FF4500,thickness=3]-> m2 : исходящие машины (16 паллет с ящиками/машина)

' ==== ПОТОКИ ЯЩИКОВ (розово-красные) ====
z3 -[#DC143C]-> z4 : пустые повторные ящики (80 %)
m3 -[#DC143C]-> z4 : новые ящики (20 %)
z4 -[#DC143C]-> f1 : пустые ящики (установка на этап заполнения)
z6 -[#DC143C]-> z13 : бракованные ящики (удаление)
z13 -[#DC143C]-> out1 : вывоз прессованного брака

' ==== ПОТОКИ ПАЛЛЕТ (синие) ====
z2 -[#1E90FF]-> zp : порожние паллеты
zp -[#1E90FF]-> z9 : подача порожних паллет на паллетирование
zp -[#1E90FF]-> out1 : возврат излишка паллет (вывоз)

' ==== ПОТОК NONSORT (зелёный) ====
z5 -[#228B22]-> n1 : товары nonsort (форма, хрупкость, негабарит > 320 мм)
z12 -[#228B22]-> n1 : перевод в nonsort (после отбраковки)
n1 -[#228B22]-> n2 : отсортированные товары (ручная сортировка по адресным ячейкам)
n2 -[#228B22]-> g2 : роллтейнеры с товарами (16/машина)
g2 -[#808080]-> n2 : роллтейнеры порожние (возврат)

' ==== ВОЗВРАТНЫЙ ПОТОК ИСКЛЮЧЕНИЙ (фиолетовый) ====
z6 -[#8B008B]-> z12 : исключения (канал повторного прогона)
z5 -[#8B008B]-> z12 : исключения (нечитаемый код и др.)
z12 -[#8B008B]-> z5 : повторная подача (скан)

' ==== ВСПОМОГАТЕЛЬНЫЕ ПОТОКИ (серые) ====
z6 -[#808080]-> z5 : упавшие товары (подъём, повторная подача)
z2 -[#808080]-> z13 : отходы (плёнка, ленты)
z3 -[#808080]-> z13 : отходы (скотч)
z13 -[#808080]-> out1 : вывоз отходов

' ==== ДВИЖЕНИЯ РОБОТОВ-ПЕРЕВОЗЧИКОВ (пунктир) ====
z14 -[#808080,dashed]-> z6 : роботы-перевозчики (паллеты, ящики)
z14 -[#808080,dashed]-> n2 : роботы-перевозчики (роллтейнеры)
z14 -[#808080,dashed]-> z2 : роботы-перевозчики (порожние паллеты)

legend right
|= Цвет |= Поток / зона |
| <#FF4500> | основной поток товаров (самый яркий, толщина 3) |
| <#FFA500> | зоны основного потока |
| <#DC143C> | потоки ящиков (повторные 80 %, новые 20 %, заполненные, брак) |
| <#FFB6C1> | зоны потоков ящиков |
| <#1E90FF> | потоки паллет (входные, порожние -> паллетирование, возврат излишка, исходящие) |
| <#87CEFA> | зоны потоков паллет |
| <#228B22> | поток nonsort (товары -> адресные ячейки -> роллтейнеры -> отгрузка) |
| <#90EE90> | зоны потока nonsort (адресные ячейки, роллтейнер-станции) |
| <#8B008B> | возвратный поток исключений (повторный прогон / отбраковка) |
| <#DDA0DD> | зоны возвратных потоков |
| <#808080> | вспомогательные потоки (отходы, вывоз, порожние роллтейнеры) |
| <#D3D3D3> | инфраструктура (зарядные станции, серверная) |
| пунктир | движения роботов-перевозчиков |
endlegend

@enduml